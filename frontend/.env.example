NEXT_PUBLIC_API_URL=http://localhost:8000

# Entra ID Authentication (optional — leave empty for local dev without auth)
# NEXT_PUBLIC_ENTRA_CLIENT_ID=your-client-id
# NEXT_PUBLIC_ENTRA_TENANT_ID=your-tenant-id
# NEXT_PUBLIC_ENTRA_REDIRECT_URI=http://localhost:3000

# In production (Azure Container Apps), these are set via Bicep/azure.yaml:
# NEXT_PUBLIC_API_URL=https://ca-backend-xxx.azurecontainerapps.io
# NEXT_PUBLIC_ENTRA_REDIRECT_URI=https://voice.turboagent.nl
