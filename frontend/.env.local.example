# Base URL for the FastAPI backend that powers the web frontend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Azure Entra application (client) ID for the web SPA. Leave empty when auth is disabled locally.
NEXT_PUBLIC_ENTRA_CLIENT_ID=

# Azure Entra tenant ID that owns the app registration. Leave empty when auth is disabled locally.
NEXT_PUBLIC_ENTRA_TENANT_ID=

# Redirect URI registered on the Entra app for the frontend.
NEXT_PUBLIC_ENTRA_REDIRECT_URI=http://localhost:3000
