COSMOS_ENDPOINT=https://localhost:8081
COSMOS_KEY=your-cosmos-key
COSMOS_DATABASE=turbovoice

# Azure OpenAI — East US 2 (primary)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-5.2
AZURE_OPENAI_SEARCH_DEPLOYMENT=gpt-4.1

# Azure OpenAI — West US (deep research)
AZURE_OPENAI_WESTUS_ENDPOINT=https://your-westus-resource.openai.azure.com
AZURE_OPENAI_WESTUS_API_KEY=your-westus-api-key
AZURE_OPENAI_DEEP_RESEARCH_DEPLOYMENT=o3-deep-research

# Voice Live
VOICE_LIVE_ENDPOINT=wss://your-resource.openai.azure.com
VOICE_LIVE_DEPLOYMENT=gpt-realtime
VOICE_LIVE_API_KEY=your-voice-live-key

# Marketing Agent (Sora-2)
SORA_ENDPOINT=https://your-foundry-resource.openai.azure.com
SORA_API_KEY=your-sora-key
SORA_DEPLOYMENT=sora-2

# Speech Avatar (animated talking head for marketing videos)
# SPEECH_AVATAR_REGION=eastus2
# SPEECH_API_KEY=your-speech-key
# SPEECH_AVATAR_VOICE=en-US-AvaMultilingualNeural

# Data directory (default: data)
# DATA_DIR=data

# Azure Blob Storage (for skills persistence)
# AZURE_STORAGE_ACCOUNT_NAME=your-storage-account

# Entra ID Authentication
# ENTRA_TENANT_ID=your-tenant-id
# ENTRA_CLIENT_ID=your-client-id
# AUTH_DISABLED=true               # Set true for local dev without Entra ID
# ALLOWED_ORIGINS=http://localhost:3000

# Microsoft To-Do OAuth (uses 'common' authority by default so personal accounts work)
# TODO_OAUTH_TENANT_ID=common      # Override: 'common', 'consumers', 'organizations', or a tenant ID
# TODO_OAUTH_CLIENT_ID=            # Separate app registration for To-Do (falls back to ENTRA_CLIENT_ID)
# TODO_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/callback/microsoft-todo
# ENTRA_CLIENT_SECRET=             # Required for To-Do OAuth code exchange

# NOTE: In production with Managed Identity, omit all *_API_KEY and *_KEY
# variables. The app auto-detects managed identity via DefaultAzureCredential.

# Mistral Document AI (image-to-text for idea refinement)
# MISTRAL_DOCUMENT_AI_ENDPOINT=https://ai-eastus2-xxxx.openai.azure.com
MISTRAL_DOCUMENT_AI_DEPLOYMENT=mistral-document-ai-2512

# Copilot CLI Sandbox (local: docker-compose sandbox on port 4000)
SANDBOX_URL=http://localhost:4000
# AUTO_START_SANDBOX=true          # Auto-start Docker sandbox on backend startup (default: true)
#                                  # Set to false if you manage the sandbox container yourself
