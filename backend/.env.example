# Azure Cosmos DB endpoint - get from: Cosmos DB resource > Overview > URI
COSMOS_ENDPOINT=https://<your-cosmos-account>.documents.azure.com:443/
# Azure Cosmos DB key - get from: Cosmos DB resource > Keys > PRIMARY KEY (omit when using managed identity)
COSMOS_KEY=<your-cosmos-key>
# Azure Cosmos DB database name - choose a database name for this application
COSMOS_DATABASE=turbovoice

# Primary Azure OpenAI endpoint - get from: Azure AI Foundry or Azure OpenAI resource > Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/
# Primary Azure OpenAI API key - get from: Azure AI Foundry or Azure OpenAI resource > Keys and Endpoint (omit when using managed identity)
AZURE_OPENAI_API_KEY=<your-openai-api-key>
# Primary chat model deployment name - get from: Azure AI Foundry > Deployments
AZURE_OPENAI_DEPLOYMENT=gpt-5.2
# Search/refinement model deployment name - get from: Azure AI Foundry > Deployments
AZURE_OPENAI_SEARCH_DEPLOYMENT=gpt-4.1

# Secondary Azure OpenAI endpoint for deep research - get from: Azure AI Foundry or Azure OpenAI resource > Keys and Endpoint
AZURE_OPENAI_WESTUS_ENDPOINT=https://<your-secondary-openai-resource>.openai.azure.com/
# Secondary Azure OpenAI API key - get from: Azure AI Foundry or Azure OpenAI resource > Keys and Endpoint (omit when using managed identity)
AZURE_OPENAI_WESTUS_API_KEY=<your-secondary-openai-api-key>
# Deep research deployment name - get from: Azure AI Foundry > Deployments
AZURE_OPENAI_DEEP_RESEARCH_DEPLOYMENT=o3-deep-research

# Voice Live WebSocket endpoint - get from: Azure AI Foundry realtime/voice deployment endpoint
VOICE_LIVE_ENDPOINT=wss://<your-openai-resource>.openai.azure.com/
# Voice Live deployment name - get from: Azure AI Foundry > Deployments
VOICE_LIVE_DEPLOYMENT=gpt-realtime
# Voice Live API key - get from: Azure AI Foundry or Azure OpenAI resource > Keys and Endpoint (omit when using managed identity)
VOICE_LIVE_API_KEY=<your-voice-live-api-key>

# Sora endpoint for marketing video generation - get from: Azure AI Foundry project > Keys and Endpoint
SORA_ENDPOINT=https://<your-foundry-resource>.openai.azure.com/
# Sora API key - get from: Azure AI Foundry project > Keys and Endpoint (omit when using managed identity)
SORA_API_KEY=<your-sora-api-key>
# Sora deployment name - get from: Azure AI Foundry > Deployments
SORA_DEPLOYMENT=sora-2

# Speech Avatar region - get from: Azure AI Speech resource > Overview > Region
# SPEECH_AVATAR_REGION=<your-speech-region>
# Speech API key - get from: Azure AI Speech resource > Keys and Endpoint
# SPEECH_API_KEY=<your-speech-api-key>
# Speech Avatar voice name - get from: Azure AI Speech Studio > Voice Gallery
# SPEECH_AVATAR_VOICE=en-US-AvaMultilingualNeural

# Local data directory - set a relative path if you want to override the default `data` directory
# DATA_DIR=data

# Azure Storage account name for skills persistence - get from: Storage account resource > Overview > Name
# AZURE_STORAGE_ACCOUNT_NAME=<your-storage-account-name>

# Entra tenant ID - get from: Microsoft Entra admin center > Overview > Tenant ID
# ENTRA_TENANT_ID=<your-tenant-id>
# Entra app (client) ID - get from: App registrations > Your app > Application (client) ID
# ENTRA_CLIENT_ID=<your-client-id>
# Disable auth for local development without Entra ID - keep true for local dev
AUTH_DISABLED=true
# Allowed browser origins for local development - set to your frontend URL(s)
# ALLOWED_ORIGINS=http://localhost:3000

# Microsoft To Do OAuth tenant - use `common`, `consumers`, `organizations`, or your tenant ID
# TODO_OAUTH_TENANT_ID=common
# Microsoft To Do OAuth client ID - use a dedicated app registration, or omit to fall back to ENTRA_CLIENT_ID
# TODO_OAUTH_CLIENT_ID=
# Microsoft To Do OAuth redirect URI - register this callback URL in your app registration
# TODO_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/callback/microsoft-todo
# Entra client secret for OAuth code exchange - get from: App registrations > Certificates & secrets
# ENTRA_CLIENT_SECRET=

# In production with managed identity, omit all *_API_KEY and *_KEY variables.

# Mistral Document AI endpoint - get from: Azure AI Foundry or Azure OpenAI resource > Keys and Endpoint
# MISTRAL_DOCUMENT_AI_ENDPOINT=https://<your-document-ai-resource>.openai.azure.com/
# Mistral Document AI deployment name - get from: Azure AI Foundry > Deployments
MISTRAL_DOCUMENT_AI_DEPLOYMENT=mistral-document-ai-2512

# Local sandbox base URL - use the docker-compose sandbox for local development
SANDBOX_URL=http://localhost:4000
# Auto-start the Docker sandbox on backend startup - set to false if you manage the sandbox yourself
# AUTO_START_SANDBOX=true
