{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": { "value": "${AZURE_RESOURCE_LOCATION=eastus2}" },
    "resourceGroupName": { "value": "${AZURE_RESOURCE_GROUP=rg-turbo-voice-agent}" },
    "azdEnvironmentName": { "value": "${AZURE_ENV_NAME=}" },
    "cosmosDbThroughput": { "value": 400 },
    "primaryAiLocation": { "value": "${AZURE_OPENAI_LOCATION_PRIMARY=eastus2}" },
    "voiceAiLocation": { "value": "${AZURE_OPENAI_LOCATION_VOICE=centralus}" },
    "researchAiLocation": { "value": "${AZURE_OPENAI_LOCATION_RESEARCH=westus}" },
    "entraTenantId": { "value": "${ENTRA_TENANT_ID}" },
    "entraClientId": { "value": "${ENTRA_CLIENT_ID}" },
    "entraClientSecret": { "value": "${ENTRA_CLIENT_SECRET=}" },
    "customDomainName": { "value": "${CUSTOM_DOMAIN_NAME=}" },
    "existingCertName": { "value": "${EXISTING_CERT_NAME=}" },
    "deployerPrincipalId": { "value": "${DEPLOYER_PRINCIPAL_ID=}" },
    "deployRbac": { "value": "${DEPLOY_RBAC=true}" }
  }
}
